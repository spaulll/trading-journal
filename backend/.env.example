# Production template — copy to .env and fill in real values.
# Deploy target uses /opt paths; dev uses local paths (see .env).
# >>> EDIT backend/.env (dev: /root/trading-journal/backend/.env,
#     prod: /opt/trading-journal/backend/.env) — user fills secrets there. <<<
APP_ENV=production
DATABASE_URL=sqlite:////opt/trading-journal/backend/journal.db
TG_BOT_TOKEN=your_telegram_bot_token_here
TG_ALLOWED_USER_ID=your_numeric_telegram_user_id
IMMICH_BASE_URL=http://<IMMICH_HOST>:2283
IMMICH_API_KEY=your_immich_key_here
PORT=8000
MAX_DAILY_LOSS=-250.0
MAX_DAILY_TRADES=3
# --- Analytics depth (Phase 7) ---
# Decided trades a setup needs before it is ranked. Below this it is
# reported as insufficient instead of being compared to a larger sample.
MIN_SAMPLE_SIZE=20
# --- Currency (Phase 4) ---
# Currency all account balances and analytics totals are reported in.
FX_BASE_CURRENCY=USD
# Label stored on manually entered rates; a provider name once one is wired.
FX_RATE_SOURCE=manual
STALE_TRADE_HOURS=4
EOD_PROMPT_HOUR=21
EOD_PROMPT_MINUTE=0
# IANA timezone for the EOD prompt (e.g. Asia/Kolkata for 22:00 IST).
EOD_TZ=UTC
# Weekly review: generated, stored and pushed Monday morning, in EOD_TZ.
# day_of_week accepts mon/tue/… or 0–6 (Monday = 0).
WEEKLY_REVIEW_DOW=mon
WEEKLY_REVIEW_HOUR=7
WEEKLY_REVIEW_MINUTE=0
# Legacy one-shot CSV import only (PLAN-v2 Task 1.4). Not used at runtime.
TG_BOT_CSV_PATH=/opt/tg-trade-logger/trades.csv

# --- LLM (weekend review summaries) ---
# OpenAI-compatible chat endpoint. Secrets stay server-side; the frontend
# only ever receives rendered markdown.
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=your_llm_api_key_here
LLM_MODEL=openai/gpt-oss-20b
# Token budget for one summary. Reasoning models (gpt-oss, r1, o-series) bill
# their hidden reasoning trace against this, so keep it well above the ~600
# tokens a summary actually needs.
LLM_MAX_TOKENS=3000
# Reasoning effort for reasoning-capable models: low | medium | high.
# "low" keeps the trace short and the summary complete. Leave blank to omit.
LLM_REASONING_EFFORT=low
# Per-request timeout (seconds) and how many extra attempts to make on a
# rate limit (429) or a truncated/empty answer.
LLM_TIMEOUT_S=120
LLM_RETRIES=2

# Production template — copy to .env and fill in real values.
# Deploy target uses /opt paths; dev uses local paths (see .env).
APP_ENV=production
DATABASE_URL=sqlite:////opt/trading-journal/backend/journal.db
TG_BOT_CSV_PATH=/opt/tg-trade-logger/trades.csv
IMMICH_BASE_URL=http://<IMMICH_HOST>:2283
IMMICH_API_KEY=your_immich_key_here
PORT=8000
